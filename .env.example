# ============ PostgreSQL (relational) ============
# Local (docker compose):
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# Cloud (vi du Neon) - dan chuoi ket noi lay tu dashboard, giu nguyen ?sslmode=require:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ============ Qdrant (vector) ============
# Local (docker compose):
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Cloud: dan Cluster URL va API key lay tu cloud.qdrant.io
# QDRANT_URL=https://xxxx.region.cloud.qdrant.io
# QDRANT_API_KEY=dan-api-key-vao-day
QDRANT_COLLECTION=rag_chunks

# ============ LLM (tra loi cau hoi) ============
# De trong LLM_API_BASE de dung OpenAI chinh hang (can OPENAI_API_KEY).
# Dien LLM_API_BASE de dung dich vu tuong thich OpenAI:
#   Groq   : https://api.groq.com/openai/v1
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai/
#   Mistral: https://api.mistral.ai/v1
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ============ Models local (khong can API key) ============
DENSE_MODEL=BAAI/bge-m3
DENSE_DIM=1024
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=BAAI/bge-reranker-v2-m3
ENABLE_RERANK=true
# cpu | cuda | mps (de trong = tu chon)
DEVICE=
EMBED_BATCH_SIZE=16

# ============ Chunking ============
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ============ Retrieval funnel ============
HYBRID_TOP_K=50
FINAL_TOP_K=5

# ============ Ingest ============
DEFAULT_LANGUAGE=vi
